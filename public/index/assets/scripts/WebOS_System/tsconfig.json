{
    "buildOptions": {
        "verbose": true,
        "traceResolution": true
    },
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "pretty": true,
        "diagnostics": true,
        "removeComments": true,
        "sourceMap": true,
        "sourceRoot": "./",
        "rootDir": "./",
        "module": "commonjs",
        "outDir": "WebOS_BUILD",
        "lib": [
            "DOM",
            "ES7",
            "ES2015",
            "ES2022",
            "ES2015.Core",
            "DOM.Iterable",
            "Decorators",
        ],
        "typeRoots": [
            "./file_system/"
        ]
    }
}