{
    "buildOptions": {
        "verbose": true,
        "traceResolution": true
    },
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "pretty": true,
        "removeComments": true,
        "diagnostics": true,
        "sourceMap": true,
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        // Force no top-level exports (wraps in IIFE for browser compatibility)
        "verbatimModuleSyntax": false,
        "sourceRoot": "./",
        "rootDir": "./",
        "mapRoot": "./",
        "outDir": "WebOS_BUILD",
        "noEmitOnError": false
    },
    "include": [
        "**/*.ts"
    ]
}