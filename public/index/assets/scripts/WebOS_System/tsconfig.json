{
    "buildOptions": {
        "verbose": true,
        "traceResolution": true
    },
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "pretty": true,
        "removeComments": true,
        "diagnostics": true,
        "sourceMap": true,
        // "baseUrl": "~/",
        "sourceRoot": "./",
        "rootDir": "./",
        "rootDirs": [
            "./",
            "../../../"
        ],
        "module": "commonjs",
        "outDir": "WebOS_BUILD",
        "lib": [
            "DOM",
            "ES7",
            "ES2015",
            "ES2022",
            "ES2015.Core",
            "DOM.Iterable",
            "Decorators",
        ],
        "typeRoots": [
            "./file_system/",
            "../../../"
        ],
        // "types": [
        //     "../window_scope_definitions.d.ts"
        // ]
