{
    "buildOptions": {
        "verbose": true,
        "traceResolution": true,
    },
    "compilerOptions": {
        "typeRoots": [],
        "moduleResolution": "classic",
        "lib": [
            "ES2018",
            "DOM",
        ],
        "module": "commonjs",
        "outDir": "UtilitysBuild",
        "rootDir": "./TypeScript/",
        "removeComments": true,
        "diagnostics": true,
        "allowJs": true,
        "strict": true,
    }
}