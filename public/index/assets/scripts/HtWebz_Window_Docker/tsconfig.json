{
    "buildOptions": {
        "verbose": true,
        "force": false,
        "traceResolution": true,
    },
    "compilerOptions": {
        "target": "es2021",
        "module": "es2020",
        "moduleResolution": "bundler",
        "allowUmdGlobalAccess": true,
        "allowJs": true,
        "checkJs": false,
        "pretty": true,
        "sourceMap": true,
        "alwaysStrict": true,
        "diagnostics": true,
        "rootDir": "../", 
        "outDir": "WindowDockerBuild",  
        "typeRoots": [
            "./window_docker_system_types/"
        ]
    },
    "include": [
        "**/*",                                       /* Current project */
        "../notification_system/**/*",                /* The sibling project */
        "../../window_scope_definitions.d.ts"         /* Global definitions */
    ],
    "exclude": [
        "node_modules",
        "WindowDockerBuild"
    ]
}