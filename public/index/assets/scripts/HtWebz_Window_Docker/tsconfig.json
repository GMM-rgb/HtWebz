{
    "compilerOptions": {
        "target": "es2021",
        "module": "es2020",
        "moduleResolution": "bundler",
        "allowUmdGlobalAccess": true,
        "allowJs": true,
        "checkJs": false,
        "pretty": true,
        "sourceMap": true,
        "alwaysStrict": true,
        "diagnostics": true,
        
        /* FIX 1: Move rootDir to the common parent of both sub-projects */
        "rootDir": "../", 
        
        /* FIX 2: Explicitly define where the build goes */
        "outDir": "WindowDockerBuild",
                
        "typeRoots": [
            "./window_docker_system_types/"
        ]
    },
    "include": [
        "**/*",                                       /* Current project */
        "../notification_system/**/*",                /* The sibling project */
        "../../window_scope_definitions.d.ts"         /* Global definitions */
    ],
    "exclude": [
        "node_modules",
        "WindowDockerBuild"
    ]
}